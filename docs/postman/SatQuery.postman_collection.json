    {
      "name": "01 · Analyze — sync (multipart)",
      "item": [
        {
          "name": "Image analysis — optical",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const b = pm.response.json();",
            "pm.test('request was valid', () => pm.expect(b.input_valid).to.be.true);",
            "pm.test('routed to image_analysis', () => pm.expect(b.current_task).to.eql('image_analysis'));",
            "pm.test('single-image mode', () => pm.expect(b.temporal_mode).to.eql('single'));",
            "pm.test('produced a final answer', () => pm.expect(b.final_answer).to.be.a('string').and.not.empty);",
            "pm.test('evidence from the image specialist', () => pm.expect(b.evidence.find(e => e.agent === 'image_analysis_agent')).to.be.an('object'));",
            "pm.test('trace ends at answer_synthesis', () => {",
            "  const nodes = b.execution_trace.filter(e => e && e.node).map(e => e.node);",
            "  pm.expect(nodes).to.include('verification');",
            "  pm.expect(nodes[nodes.length - 1]).to.eql('answer_synthesis');",
            "});",
            "const last = b.evidence[b.evidence.length - 1];",
            "if (last.status === 'failed') { console.warn('VLM not usable — final_answer:', b.final_answer); }",
            "else { pm.test('finding was verified', () => pm.expect(last.verified_finding).to.be.a('string')); }"
          ] } }],
          "request": {
            "method": "POST", "header": [],
            "body": { "mode": "formdata", "formdata": [
              { "key": "query", "value": "Is there any water body in the image? Describe the land cover.", "type": "text" },
