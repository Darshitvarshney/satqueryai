          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('rejected or auth-disabled', () => pm.expect([200, 401]).to.include(pm.response.code));",
            "if (pm.response.code === 200) console.warn('Server has no API_KEYS set — auth is disabled.');"
          ] } }],
          "request": { "auth": { "type": "noauth" }, "method": "GET", "header": [], "url": { "raw": "{{base_url}}/api/v1/jobs", "host": ["{{base_url}}"], "path": ["api","v1","jobs"] } }
        },
        {
          "name": "Valid key → 200",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('returns the job list', () => pm.expect(pm.response.json()).to.be.an('array'));"
          ] } }],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{base_url}}/api/v1/jobs", "host": ["{{base_url}}"], "path": ["api","v1","jobs"] } }
        }
      ]
    }
  ]
}
