    "name": "SatQuery AI Backend",
    "description": "End-to-end tests for every SatQuery endpoint and feature.\n\nSetup:\n1. Run the backend: `python -m satquery` (defaults to http://localhost:8000).\n2. Import `SatQuery.local.postman_environment.json` and select it.\n3. Settings > General > working directory -> the repo root, so the sample\n   files under `docs/postman/samples/` resolve (or attach files by hand).\n\nRouting note: the supervisor picks the task from the QUERY + the NUMBER of\nimages. The labelled fields (optical / sar / image_t1 / image_t2) are hints;\nthe unnamed `images` field works for every task.\n\nRun the whole thing with the Collection Runner, or `newman run` / `make test-api`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      { "key": "key", "value": "X-API-Key", "type": "string" },
      { "key": "value", "value": "{{api_key}}", "type": "string" },
      { "key": "in", "value": "header", "type": "string" }
    ]
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "api_key", "value": "" },
    { "key": "job_id", "value": "" }
