# ---------------------------------------------------------------------------
# Copy to .env and fill in. Every key here maps 1:1 to a Settings field.
# ---------------------------------------------------------------------------

# --- LLM — required for routing, verification and answer synthesis ---------
# Text model is a fallback chain:
#   GROQ_MODEL  ->  each GROQ_FALLBACK_MODELS entry  ->  OpenRouter (if key set)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant
LLM_TEMPERATURE=0.0

# Optional final fallback via OpenRouter (OpenAI-compatible)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Vision model ---------------------------------------------------------- -
# local     -> load VLM_MODEL_ID with transformers (needs torch + a GPU)
# disabled  -> image specialists return a clear "vision model disabled" note
VLM_BACKEND=local
VLM_MODEL_ID=manny2706/satquery-qwen2vl-4bitQuantized
VLM_DEVICE_MAP=auto
VLM_TORCH_DTYPE=bfloat16
VLM_MAX_NEW_TOKENS=256
VLM_LOAD_ON_STARTUP=false

# --- Server --------------------------------------------------------------- -
API_HOST=0.0.0.0
API_PORT=8000
RELOAD=false
LOG_LEVEL=INFO
CORS_ORIGINS=*
# API_KEYS=key-one,key-two      # if set, callers must send  X-API-Key: <key>
MAX_UPLOAD_MB=25

# --- Graph -------------------------------------------------------------- ---
DEFAULT_MAX_RETRIES=2
MIN_CONFIDENCE=0.75
RECURSION_LIMIT=60

# --- Storage ------------------------------------------------------------ ---
# Defaults to <repo>/var/uploads (works on any OS). Override if needed:
# WORK_DIR=/var/www/satquery/var/uploads          # Linux / macOS
# WORK_DIR=C:\satquery\uploads                     # Windows
