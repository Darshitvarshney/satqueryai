# ---------------------------------------------------------------------------
# Copy to .env and fill in. Every key here maps 1:1 to a Settings field.
# ---------------------------------------------------------------------------

# --- LLM (Groq) — required for routing, verification and answer synthesis ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.0

# --- Vision model ---------------------------------------------------------- -
# local     -> load VLM_MODEL_ID with transformers (needs torch + a GPU)
# disabled  -> image specialists return a clear "vision model disabled" note
VLM_BACKEND=local
VLM_MODEL_ID=manny2706/satquery-qwen2vl-16bit
VLM_DEVICE_MAP=auto
VLM_TORCH_DTYPE=bfloat16
VLM_MAX_NEW_TOKENS=256
VLM_LOAD_ON_STARTUP=false

# --- Server --------------------------------------------------------------- -
API_HOST=0.0.0.0
API_PORT=8000
RELOAD=false
LOG_LEVEL=INFO
CORS_ORIGINS=*
# API_KEYS=key-one,key-two      # if set, callers must send  X-API-Key: <key>
MAX_UPLOAD_MB=25

# --- Graph -------------------------------------------------------------- ---
DEFAULT_MAX_RETRIES=2
MIN_CONFIDENCE=0.75
RECURSION_LIMIT=60

# --- Storage ------------------------------------------------------------ ---
# WORK_DIR=/var/www/satquery/var/uploads

# OPENROUTER_API_KEY=
